# DeepSeek-compatible endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_MODEL=deepseek-flash
# enabled | disabled | auto (GM thinks, actors act fast)
LLM_THINKING=auto
PORT=4386
HOST=127.0.0.1


# 模型提供方：deepseek（默认）或 minimax（Anthropic 兼容接口）
# LLM_PROVIDER=minimax
# MINIMAX_BASE_URL=https://api.minimax.cn/anthropic
# MINIMAX_API_KEY=sk-...
# MINIMAX_MODEL=MiniMax-M3.1-Flash
# MINIMAX_EFFORT=max   # low | medium | high | xhigh | max

# LLM_TIMEOUT_MS=600000
